<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../POC2/Assets/Scripts/Logging/*.cs" Exclude="../../../POC2/Assets/Scripts/Logging/LogUnityAdapter.cs" />
    <Compile Include="../../../POC2/Assets/Scripts/Data/LogData.cs" />
    <Compile Include="../../../POC2/Assets/Scripts/Info/LogInfo.cs" />
    <JsonAssembly Include="../../../POC2/Library/PackageCache/com.unity.nuget.newtonsoft-json@*/Runtime/Newtonsoft.Json.dll" />
    <Reference Include="Newtonsoft.Json"><HintPath>@(JsonAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>
